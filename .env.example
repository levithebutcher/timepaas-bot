# Telegram Bot Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to public repositories!

# Telegram API Credentials (get from https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Authorized User / Admin IDs (comma-separated if multiple)
ADMIN_IDS=your_telegram_user_id

# Optional: Streamtape Developer API (Leave blank to use automatic zero-config web scraper)
STREAMTAPE_LOGIN=
STREAMTAPE_KEY=

# Bot Configuration & Limits
MAX_CONCURRENT_TASKS=3
MAX_USER_TASKS=10
MIN_FREE_DISK_GB=3
DOWNLOAD_DIR=downloads
PROGRESS_UPDATE_INTERVAL=5
